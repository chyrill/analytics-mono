# ── Analytics Mono — Environment Variables ────────────────────────────────────
# Copy to .env (root) or apps/*/. env.local and fill in values.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://analytics:analytics@localhost:5433/analytics

# ── Zoho CRM ──────────────────────────────────────────────────────────────────
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_API_BASE=https://www.zohoapis.com/crm/v6

# ── Saleor ────────────────────────────────────────────────────────────────────
SALEOR_API_URL=https://srx.harvest.delivery/api/graphql/
SALEOR_API_TOKEN=

# ── Doc-App DB (read-only) ────────────────────────────────────────────────────
DOCAPP_DATABASE_URL=

# ── Web (Next.js static shell) ────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:3001

# ── AWS (prod deploy) ─────────────────────────────────────────────────────────
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=harvest-analytics-prod
CF_DISTRIBUTION_ID=
